#) Display the First CD in an HTML div Element:
    - This example uses a function to display the first CD element in an HTML element with id="showCD":

        <div id="showCD"></div>
    
        <script>
            const xhttp = new XMLHttpRequest();
            xhttp.onload = function() {
                const xmlDoc = xhttp.responseXML;
                const cd = xmlDoc.getElementsByTagName("CD");
                myFunction(cd, 0);  // passing argument i as a 0 because we want to display only the first CD element
            };
            xhttp.open("GET", "cd_catalog.xml");
            xhttp.send();

            function myFunction(cd, i) {
                document.getElementById("showCD").innerHTML =
                    "Title: " + cd[i].getElementsByTagName("TITLE")[0].childNodes[0].nodesValue +
                    "<br>Artist: " + cd[i].getElementsByTagName("ARTIST")[0].childNodes[0].nodeValue +
                    "<br>Year: " + cd[i].getElementsByTagName("YEAR")[0].childNodes[0].nodeValue;
            }
        </script>

